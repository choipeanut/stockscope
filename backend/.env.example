# ── 로그인 (없으면 로그인이 아예 안 됩니다) ─────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# 프론트엔드의 VITE_GOOGLE_CLIENT_ID와 반드시 같은 값이어야 합니다.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# 아무 랜덤 문자열. 바꾸면 기존 로그인 세션이 전부 무효화됩니다.
JWT_SECRET=change-me-to-a-long-random-string

# ── 데이터 소스 ─────────────────────────────────────────────────────────
DART_API_KEY=
FRED_API_KEY=
ECOS_API_KEY=

# 프론트엔드 배포 주소 (쉼표로 여러 개). 없으면 브라우저가 CORS로 막습니다.
ALLOWED_ORIGINS=https://your-app.vercel.app

# 비우면 SQLite 사용
DATABASE_URL=

# pykrx 수급/밸류에이션을 쓸 때만. 없으면 해당 지표는 조용히 건너뜁니다.
KRX_ID=
KRX_PW=
